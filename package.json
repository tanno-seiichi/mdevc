{
  "name": "mdevc",
  "displayName": "mdevc - Inline Markdown Editor for Visual Studio Code",
  "description": "%description%",
  "version": "0.1.2",
  "publisher": "tanno-seiichi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tanno-seiichi/mdevc.git"
  },
  "icon": "images/mde.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "editor",
    "wysiwyg"
  ],
  "main": "./extension.js",
  "scripts": {
    "package": "npx @vscode/vsce package"
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "mdevc.markdownEditor",
        "displayName": "%customEditor.displayName%",
        "selector": [
          { "filenamePattern": "*.md" },
          { "filenamePattern": "*.markdown" }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "mdevc.openWithTextEditor",
        "title": "%command.openWithTextEditor%",
        "category": "mdevc",
        "icon": "$(go-to-file)"
      },
      {
        "command": "mdevc.openWithMdevc",
        "title": "%command.openWithMdevc%",
        "category": "mdevc",
        "icon": "$(open-preview)"
      },
      {
        "command": "mdevc.openHelp",
        "title": "%command.openHelp%",
        "category": "mdevc",
        "icon": "$(question)"
      },
      {
        "command": "mdevc.revealHeading",
        "title": "%command.revealHeading%",
        "category": "mdevc"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "mdevc.outline",
          "name": "%view.outline%",
          "when": "activeCustomEditorId == mdevc.markdownEditor"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "mdevc.openWithTextEditor",
          "when": "activeCustomEditorId == mdevc.markdownEditor",
          "group": "navigation"
        },
        {
          "command": "mdevc.openWithMdevc",
          "when": "editorLangId == markdown && !isInDiffEditor",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "mdevc.openWithMdevc",
          "when": "resourceLangId == markdown",
          "group": "navigation@9"
        }
      ],
      "commandPalette": [
        {
          "command": "mdevc.openWithTextEditor",
          "when": "activeCustomEditorId == mdevc.markdownEditor"
        },
        {
          "command": "mdevc.openWithMdevc",
          "when": "editorLangId == markdown"
        },
        {
          "command": "mdevc.revealHeading",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "mdevc",
      "properties": {
        "mdevc.language": {
          "type": "string",
          "enum": [ "auto", "ja", "en" ],
          "enumItemLabels": [ "%config.language.label1%", "%config.language.label2%", "%config.language.label3%" ],
          "enumDescriptions": [ "%config.language.enum1%", "%config.language.enum2%", "%config.language.enum3%" ],
          "default": "auto",
          "order": 5,
          "description": "%config.language.description%"
        },
        "mdevc.docStyle": {
          "type": "string",
          "enum": [ "github", "vscode" ],
          "enumItemLabels": [ "%config.docStyle.label1%", "%config.docStyle.label2%" ],
          "enumDescriptions": [ "%config.docStyle.enum1%", "%config.docStyle.enum2%" ],
          "default": "github",
          "order": 10,
          "description": "%config.docStyle.description%"
        },
        "mdevc.textColor": {
          "type": "string",
          "enum": [ "sharp", "soft" ],
          "enumItemLabels": [ "%config.textColor.label1%", "%config.textColor.label2%" ],
          "enumDescriptions": [ "%config.textColor.enum1%", "%config.textColor.enum2%" ],
          "default": "sharp",
          "order": 20,
          "description": "%config.textColor.description%"
        },
        "mdevc.docWidth": {
          "type": "string",
          "enum": [ "limited", "full" ],
          "enumItemLabels": [ "%config.docWidth.label1%", "%config.docWidth.label2%" ],
          "enumDescriptions": [ "%config.docWidth.enum1%", "%config.docWidth.enum2%" ],
          "default": "limited",
          "order": 30,
          "description": "%config.docWidth.description%"
        },
        "mdevc.softBreak": {
          "type": "string",
          "enum": [ "join", "source" ],
          "enumItemLabels": [ "%config.softBreak.label1%", "%config.softBreak.label2%" ],
          "enumDescriptions": [ "%config.softBreak.enum1%", "%config.softBreak.enum2%" ],
          "default": "join",
          "order": 40,
          "description": "%config.softBreak.description%"
        }
      }
    }
  }
}
